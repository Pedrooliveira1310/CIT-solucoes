# Exporte estas variáveis no shell ou configure-as no seu gerenciador de segredos.
# Flask não lê este arquivo automaticamente; não inclua credenciais no Git.
ANALYSIS_MODE=demo
TRANSCRIPTION_MODE=demo
# Somente no servidor; necessário ao selecionar openai.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
TRANSCRIPTION_MODEL=whisper-1
# Ative somente após revisar e comunicar a retenção e o tratamento pelo provedor.
TRANSCRIPTION_PRIVACY_ACK=no
# Em produção HTTPS, obrigatoriamente true.
COOKIE_SECURE=false
# Opcionais: caminhos absolutos, privados e com permissões restritas.
# DATABASE_PATH=/caminho/privado/cti.sqlite
# AUDIO_TEMP_DIR=/caminho/temporario/cti-audio
